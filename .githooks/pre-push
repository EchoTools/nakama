#!/bin/bash
# pre-push hook: quality gates for EchoTools/nakama
#
# 0. Destination: refuse a push that RESOLVES to main
# 1. Tag format: reject semver tags without -evr.<N>
# 2. Go quality: run fast checks on changed files
#    (gofmt, go vet, golangci-lint via `just lint`, gopls check, go mod tidy)
#
# Install: automatic on the first `just <recipe>`; or `just hooks`; or
#          git config core.hooksPath .githooks
# Skip:    git push --no-verify
#
# THIS HOOK IS OFF UNTIL ARMED, AND ITS FAILURE MODE IS SILENCE.
#
# core.hooksPath is local config and cannot be committed, so this file shipping
# with the repo does not activate it. Until something sets that config in a
# given clone, git never looks here and pushes are unguarded -- with no warning,
# since a hook that is not wired up is indistinguishable from one that approved.
#
# The justfile now arms the clone whenever any recipe runs (see _HOOKS_ARMED
# there), so in practice `just test` or `just nakama` is enough. That shrinks
# the window; it does not close it. Git will not let a repository activate its
# own hooks -- a clone that armed itself would be arbitrary code execution on
# `git clone` -- so a clone that pushes without ever running a recipe is still
# unguarded, permanently and by design.
#
# That residual gap is not a rounding error: a fresh clone, a newly created
# worktree, and an agent starting cold are all unarmed until they run something,
# and those are exactly the situations phase 0 was built for.
#
# Check whether it is armed:
#
#     git config --get core.hooksPath     # must print .githooks
#
# Note that `git push --no-verify` skips this hook ENTIRELY, phase 0 included.
# The backstop for both gaps is .github/workflows/main-push-audit.yaml, which is
# server-side and arms itself -- but is detection after the fact, not
# prevention. Actual prevention would be GitHub branch protection requiring a
# PR; that is a repository setting and the owner's decision.

set -e

# ---- Color helpers ----
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color
pass() { echo -e " ${GREEN}✓${NC} $1"; }
fail() { echo -e " ${RED}✗${NC} $1"; fail_count=$((fail_count + 1)); }
warn() { echo -e " ${YELLOW}⚠${NC} $1"; }
fail_count=0

REPO_ROOT="$(git rev-parse --show-toplevel)"

# Git invokes a pre-push hook as: pre-push <remote-name-or-url> <remote-url>
PUSH_REMOTE="${1:-origin}"

# ---- Capture push refs ----
# Pre-push receives refs on stdin: <local-ref> <local-sha> <remote-ref> <remote-sha>
# Store them so we can iterate in multiple phases.
PUSH_REFS=$(cat)

# ---- Phase 0: Destination check ----
#
# A branch created with `git worktree add <dir> -b <branch> origin/main` tracks
# origin/main. With push.default=tracking, git resolves the destination from the
# branch's UPSTREAM rather than its name, so
#
#     git push -u origin my-feature-branch
#
# names the feature branch twice and pushes it to refs/heads/main. It does not
# look wrong at the call site, and it has happened twice in this repo.
#
# The remote ref below is the RESOLVED destination -- the value that was wrong
# both times, and the one nobody reads at the call site. That is why the check
# belongs in a hook and not in a wrapper around the push command.
#
# An authorized push to main must be STATED, never inferred:
#
#     ALLOW_MAIN_PUSH=1 git push origin HEAD:refs/heads/main
#
# Scope: refuses pushes to main from anywhere, not only from linked worktrees. A
# gate scoped to the way it happened last time is a gate with a hole in it.
if [ "${ALLOW_MAIN_PUSH:-}" != "1" ]; then
    while read -r local_ref local_sha remote_ref remote_sha; do
        # Explicit `if` rather than `[ ... ] && continue`: under `set -e` a
        # trailing AND-list that evaluates false is a non-zero body result, and
        # whether that aborts the hook depends on shell version and position.
        # Not worth relying on for a guard.
        if [ "${remote_ref:-}" != "refs/heads/main" ]; then
            continue
        fi

        fail "This push resolves to main (source: ${local_ref:-<unknown>})"
        if [ "${local_ref:-}" != "refs/heads/main" ]; then
            upstream="$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
            echo "       The source is not main, so this is very likely the upstream trap:"
            echo "       push.default is '$(git config --get push.default || echo unset)'"
            echo "       and this branch's upstream is '${upstream:-<none>}'."
            echo "       git took the destination from the upstream, not the branch name."
        fi
        echo "       Use an explicit refspec: git push origin HEAD:refs/heads/<branch>"
        echo "       To push to main deliberately: ALLOW_MAIN_PUSH=1 git push ..."
    # A here-string, NOT a pipe: a piped `while` runs in a subshell, so every
    # fail_count increment inside it is discarded and the summary below cannot
    # see it. See phase 1 -- that bug is why its tag gate never rejected.
    done <<< "$PUSH_REFS"
fi

# ---- Phase 1: Tag format check ----
# Reads from a here-string rather than a pipe. Piping PUSH_REFS into `while`
# put the loop in a subshell, so `fail` incremented a COPY of fail_count and the
# summary at the bottom always saw 0 -- this gate has never actually rejected a
# malformed tag since it was written.
while read -r local_ref local_sha remote_ref remote_sha; do
    [[ "$remote_ref" != refs/tags/* ]] && continue
    tag="${remote_ref#refs/tags/}"
    [[ "$tag" =~ ^v[0-9] ]] || continue
    if [[ ! "$tag" =~ -evr\.[0-9]+$ ]]; then
        fail "Tag '$tag' rejected — EVR releases use v3.27.2-evr.<N>"
        echo "       Upstream Nakama tags (v3.x.x) must not be pushed here."
    fi
done <<< "$PUSH_REFS"

# ---- Phase 2: Go quality checks ----
#
# The file set comes from the refs actually being pushed. That is the only
# authoritative source, and getting it from anywhere else made this phase
# fail open:
#
#   - ORIG_HEAD is wherever the last pull or merge happened to leave the
#     branch. It has no relationship to what is being pushed: in this repo it
#     routinely spans commits that merged days ago while omitting the commit
#     in the push.
#   - On a fresh clone ORIG_HEAD does not exist, so the old code fell back to
#     `git diff --cached`, which is EMPTY once the work is committed. Verified
#     by reproduction: clone, add an unformatted .go file, commit, push --
#     CHANGED_GO came back empty and gofmt, vet, gopls and tidy were all
#     skipped in silence. The hook printed nothing and exited 0.
#
# An all-zero remote sha means the branch does not exist on the remote yet;
# bound that range at the default branch so a first push checks the branch's
# own commits rather than all of history. An all-zero local sha is a deletion
# and carries no files.
ZERO_SHA='0000000000000000000000000000000000000000'
CHANGED_GO=""
while read -r _local_ref local_sha _remote_ref remote_sha; do
    # Explicit `if`, for the reason phase 0 documents: under `set -e` a trailing
    # AND-list that evaluates false is a non-zero body result.
    if [ -z "${local_sha:-}" ] || [ "$local_sha" = "$ZERO_SHA" ]; then
        continue
    fi

    if [ "${remote_sha:-$ZERO_SHA}" = "$ZERO_SHA" ]; then
        # Bound against the remote actually being pushed to. Git passes its
        # name as $1; hardcoding "origin" picks the wrong merge-base for anyone
        # pushing to a second remote. If $1 is a URL rather than a name (git
        # allows `git push <url>`), neither ref resolves, range_base stays
        # empty, and the tip-commit fallback below applies.
        range_base=$(git merge-base "$local_sha" "$PUSH_REMOTE/HEAD" 2>/dev/null \
            || git merge-base "$local_sha" "$PUSH_REMOTE/main" 2>/dev/null || true)
    else
        range_base="$remote_sha"
    fi

    if [ -n "$range_base" ]; then
        ref_files=$(git diff --name-only "$range_base".."$local_sha" -- '*.go' 2>/dev/null || true)
    else
        # No common ancestor to bound against (orphan branch); fall back to the
        # tip commit rather than diffing the whole history.
        ref_files=$(git show --name-only --pretty=format: "$local_sha" -- '*.go' 2>/dev/null || true)
    fi

    CHANGED_GO=$(printf '%s\n%s' "$CHANGED_GO" "$ref_files")
done <<< "$PUSH_REFS"

# Drop blanks and duplicates, and drop paths deleted by the push -- gofmt and
# gopls error on a file that is not on disk.
CHANGED_GO=$(printf '%s\n' "$CHANGED_GO" | sort -u | while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$REPO_ROOT/$f" ] && echo "$f"
done || true)

if [ -n "$CHANGED_GO" ]; then
    echo ""
    echo "── Go quality checks ──"

    # gofmt
    UNFORMATTED=$(gofmt -l $CHANGED_GO 2>/dev/null || true)
    if [ -n "$UNFORMATTED" ]; then
        fail "gofmt needs these files:"
        echo "$UNFORMATTED" | sed 's/^/       /'
    else
        pass "gofmt"
    fi

    # go vet. Show the diagnostics: sending them to /dev/null left the
    # developer with a one-line refusal and nothing to act on, and the old
    # message named a broader command than the one that actually failed.
    if VET_OUTPUT=$(go vet ./server/... 2>&1); then
        pass "go vet ./server/..."
    else
        fail "go vet ./server/... failed:"
        echo "$VET_OUTPUT" | head -20 | sed 's/^/       /'
    fi

    # golangci-lint, via `just lint` -- the backlog ratchet, not a bare run.
    #
    # AGENTS.md has called this a MUST-run gate for years while it ran in no
    # hook, no workflow and no recipe; from 2023 to 2026-08-16 it could not even
    # load its config. It is here now.
    #
    # `just lint` rather than golangci-lint directly, deliberately: the baseline
    # the ratchet compares against lives in the justfile, and a second copy of
    # that number here is a second thing to forget to update. It also brings the
    # stale-cache and did-not-run guards with it (AGENTS.md defect classes 4, 6).
    #
    # Skipped with a warning when `just` is absent, the same way gopls is --
    # a hook that hard-fails on a missing tool gets bypassed wholesale, and a
    # bypassed hook enforces nothing at all.
    if command -v just &>/dev/null; then
        if LINT_OUTPUT=$(just lint 2>&1); then
            pass "golangci-lint (backlog ratchet held)"
        else
            fail "golangci-lint:"
            echo "$LINT_OUTPUT" | head -20 | sed 's/^/       /'
        fi
    else
        warn "just not installed — skipping golangci-lint"
    fi

    # gopls check (static analysis)
    if command -v gopls &>/dev/null; then
        GOPLS_ANALYSIS=$(gopls check $CHANGED_GO 2>/dev/null | head -20 || true)
        if [ -n "$GOPLS_ANALYSIS" ]; then
            warn "gopls diagnostics (review before push):"
            echo "$GOPLS_ANALYSIS" | while IFS= read -r line; do echo "       $line"; done
        else
            pass "gopls check"
        fi
    else
        warn "gopls not installed — skipping gopls check"
    fi

    # go mod tidy check.
    #
    # `go mod tidy` rewrites go.mod/go.sum in place. Previously nothing put
    # them back, so a rejected push also left the working tree dirty with
    # changes the developer did not make -- and the dead TIDY_BEFORE variable
    # showed a restore had been intended and never written. Snapshot both
    # files and restore them whatever the outcome, so this check observes
    # without mutating.
    cd "$REPO_ROOT"
    TIDY_BACKUP=$(mktemp -d)
    cp go.mod "$TIDY_BACKUP/go.mod" 2>/dev/null || true
    cp go.sum "$TIDY_BACKUP/go.sum" 2>/dev/null || true
    # A tidy that ERRORS is a failed check, not a passed one. Discarding its
    # status with `|| true` meant a module-resolution error printed
    # "✓ go mod tidy" so long as the files happened not to change -- the same
    # could-not-check-so-call-it-fine shape this phase was just fixed for.
    if ! TIDY_OUTPUT=$(go mod tidy 2>&1); then
        fail "go mod tidy failed:"
        echo "$TIDY_OUTPUT" | head -10 | sed 's/^/       /'
    elif [ -n "$(git status --porcelain go.mod go.sum 2>/dev/null)" ]; then
        fail "go mod tidy modified go.mod/go.sum — run 'go mod tidy' and commit the result"
    else
        pass "go mod tidy"
    fi
    # Restore byte-for-byte. Capturing with $(cat) and rewriting with printf
    # does not round-trip: command substitution strips trailing newlines, so
    # the "restored" file still differed from the original and the tree stayed
    # dirty -- the very thing this is here to prevent.
    cp "$TIDY_BACKUP/go.mod" go.mod 2>/dev/null || true
    cp "$TIDY_BACKUP/go.sum" go.sum 2>/dev/null || true
    rm -rf "$TIDY_BACKUP"
    cd - >/dev/null
fi

# ---- Summary ----
if [ "$fail_count" -gt 0 ]; then
    echo ""
    echo -e " ${RED}── ${fail_count} check(s) failed — push rejected ──${NC}"
    echo " To bypass: git push --no-verify origin <branch>"
    exit 1
fi

exit 0
